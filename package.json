{
  "name": "edne",
  "version": "1.0.0",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "edne": "./src/index.ts"
  },
  "scripts": {
    "fetch": "bun run src/index.ts fetch",
    "lookup": "bun run src/index.ts lookup",
    "benchmark": "bun run benchmarks/benchmark.ts",
    "benchmark:download": "bun run benchmarks/benchmark-download.ts",
    "benchmark:micro": "bun run benchmarks/micro-benchmark.ts",
    "benchmark:batch-size": "bun run benchmarks/benchmark-batch-size.ts",
    "benchmark:direct-zip": "bun run benchmarks/benchmark-direct-zip.ts",
    "benchmark:atomic-update": "bun run benchmarks/benchmark-atomic-update.ts",
    "tsc": "bunx --bun tsc --noEmit",
    "lint:biome": "bunx --bun @biomejs/biome check",
    "lint:oxlint": "bunx --bun oxlint --type-aware",
    "lint": "bun tsc && bun lint:biome && bun lint:oxlint",
    "fmt": "bunx --bun dprint fmt"
  },
  "dependencies": {
    "@drizzle-team/brocli": "^0.12.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "dprint": "^0.56.0",
    "mitata": "^1.0.34",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}

{
  "name": "@konstit/dne",
  "version": "0.1.0",
  "description": "Query bundled Brazilian postal codes or build and update local SQLite and binary databases.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konstit-Engenharia/konstit-dne.git"
  },
  "author": {
    "name": "KONSTIT ENGENHARIA E TECNOLOGIA LTDA",
    "email": "opensource@konstit.com.br"
  },
  "contributors": [
    {
      "name": "Diego Alcântara",
      "url": "https://github.com/dgoalcantara",
      "email": "diego.alcantara@konstit.com.br"
    },
    {
      "name": "Marcelo Marchioro",
      "url": "https://github.com/Sprayscelo",
      "email": "marcelo.marchioro@konstit.com.br"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js",
      "default": "./dist/library.js"
    }
  },
  "bin": {
    "dne": "./dist/index.js"
  },
  "files": [
    "dist",
    "data/dne.bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:database": "bun run src/index.ts build",
    "build:package-database": "bun run scripts/build-package-database.ts",
    "prepack": "bun run build >&2 && bun run build:package-database >&2",
    "get": "bun run src/index.ts get",
    "test": "bun test --dots --parallel",
    "benchmark": "bun run bench/benchmark.ts",
    "benchmark:download": "bun run bench/download.bench.ts",
    "benchmark:micro": "bun run bench/micro.bench.ts",
    "benchmark:batch-size": "bun run bench/batch-size.bench.ts",
    "benchmark:direct-zip": "bun run bench/direct-zip.bench.ts",
    "benchmark:atomic-update": "bun run bench/atomic-update.bench.ts",
    "benchmark:zip-stream": "bun run bench/zip-stream.bench.ts",
    "tsc": "bunx --bun tsc --noEmit",
    "lint:biome": "bunx --bun @biomejs/biome check",
    "lint:oxlint": "bunx --bun oxlint --type-aware",
    "lint": "bun run --parallel tsc lint:biome lint:oxlint",
    "fmt": "bunx --bun dprint fmt",
    "coverage": "bun test --dots --coverage && bun run scripts/check-coverage.ts",
    "audit": "bun audit",
    "check": "bun run coverage && bun run --parallel tsc lint:biome lint:oxlint build audit",
    "build": "bun run build:artifacts",
    "build:artifacts": "bun run build:clean && bun run --parallel build:js build:library",
    "build:clean": "rm -rf ./dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target=bun --format=esm --sourcemap=external --minify --keep-names --splitting --chunk-naming 'chunks/[name]-[hash].[ext]'",
    "build:library": "bunx --bun tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@konstit/cli": "0.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "dprint": "^0.56.0",
    "mitata": "^1.0.34",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
